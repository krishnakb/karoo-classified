<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_classified"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <service
            android:name=".extension.ClassifiedExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <!-- Required for this extension to be discovered by the Karoo System -->
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <!-- Declares the data field so it appears in the Karoo field picker -->
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>
    </application>
</manifest>
